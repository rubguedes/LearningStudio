  "windows": ["main"],
  "permissions": [
    "allow-auth-status",
    "allow-setup-password",
    "allow-unlock",
    "allow-lock",
    "allow-workspace-snapshot",
    "allow-save-area",
    "allow-archive-area",
    "allow-delete-area",
    "allow-save-task",
    "allow-delete-task",
    "allow-save-session",
    "allow-start-session",
    "allow-pulse-session",
    "allow-control-session",
    "allow-save-goal",
    "allow-archive-goal",
    "allow-save-checkpoint",
    "allow-complete-checkpoint",
    "allow-reopen-checkpoint",
    "allow-delete-progress",
    "allow-user-activity",
    "allow-library-snapshot",
    "allow-library-action",
    "allow-agenda-snapshot",
    "allow-agenda-action",
    "allow-preview-import",
    "allow-google-begin",
    "allow-google-status",
    "allow-google-action",
    "allow-tutor-snapshot",
    "allow-tutor-action",
    "allow-challenge-solution",
    "allow-export-backup",
    "allow-import-backup",
    "allow-organizer-snapshot",
    "allow-organizer-action",
